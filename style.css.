
/* MATULWE - QA & AI TESTING PORTFOLIO */

:root {
    --background: #0b1120;
    --surface: #111c30;
    --text: #e5edf7;
    --muted: #94a3b8;
    --accent: #38bdf8;
    --border: #24334a;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--background);
    color: var(--text);
    font-family: Arial, sans-serif;
    line-height: 1.7;
}

header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(11, 17, 32, 0.95);
    z-index: 100;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: white;
    text-decoration: none;
}

.logo span,
.hero h1 span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
}

.nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
}

.nav-links a:hover {
    color: var(--accent);
}

.hero {
    max-width: 1100px;
    margin: auto;
    padding: 120px 20px;
}

.eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero-description {
    max-width: 620px;
    color: var(--muted);
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 30px;
}

.button {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
}

.primary {
    background: var(--accent);
    color: #07111f;
}

.secondary {
    border: 1px solid var(--border);
    color: var(--text);
}

.button:hover {
    opacity: 0.8;
}

.location {
    color: var(--muted);
    font-size: 13px;
    margin-top: 35px;
}

.section {
    max-width: 1100px;
    margin: auto;
    padding: 80px 20px;
    border-top: 1px solid var(--border);
}

.section h2 {
    font-size: 32px;
    margin-bottom: 25px;
}

.section > p:not(.eyebrow) {
    color: var(--muted);
    max-width: 750px;
    margin-bottom: 15px;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
}

.skill-card,
.project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 25px;
    border-radius: 8px;
}

.skill-card h3,
.project-card h3 {
    color: white;
    margin-bottom: 10px;
}

.skill-card p,
.project-card p {
    color: var(--muted);
    font-size: 14px;
}

.project-card {
    margin-bottom: 20px;
}

.project-type {
    color: var(--accent) !important;
    font-size: 11px !important;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.tag {
    display: inline-block;
    color: var(--accent);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    margin: 15px 5px 0 0;
}

footer {
    text-align: center;
    padding: 30px 15px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
}

@media (max-width: 650px) {
    .navbar {
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
        gap: 12px;
    }

    .hero {
        padding: 80px 20px;
    }

    .section {
        padding: 60px 20px;
    }
}
